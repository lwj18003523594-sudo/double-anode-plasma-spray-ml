    EvidenceRegistry "1" o-- "*" EvidenceItem : 注册管理
    evidence_ui ..> EvidenceItem : 徽标渲染
    quick_analysis ..> EvidenceRegistry : 创建并传递
    quick_analysis ..> SmartSummary : build/load
    quick_analysis ..> insights : _insights 步骤
    quick_analysis ..> PaperExporter : _package 步骤
    insights ..> EvidenceRegistry : statement 生成结论
    figure_analysis ..> EvidenceRegistry : 图级证据注册
    app_py ..> quick_analysis : quick_analyze_file 契约
    app_py ..> evidence_ui : badge_row / legacy_run_notice
    app_py ..> plot_style : 统一图入口
    paper_style ..> plot_style : import 色板常量
    PaperExporter ..> paper_style : 版式与保存
    PaperExporter ..> plot_style : import 色板常量
    PaperExporter ..> figure_analysis : _analysis_for
    app_py ..> paper_style : 不直接依赖
